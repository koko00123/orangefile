<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ target unlocks the built-in PDF renderer (Windows.Data.Pdf) and OCR (Windows.Media.Ocr). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Orange</AssemblyName>
    <RootNamespace>Orange</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\orange.ico</ApplicationIcon>

    <Version>1.3.0</Version>
    <Product>Orange</Product>
    <Description>Orange — file converter and phone sharing</Description>
    <Copyright>© 2026 koko</Copyright>
  </PropertyGroup>

  <!-- Tests reach internal types (models, layout logic) without making them public. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Orange.Tests" />
  </ItemGroup>

  <!-- WinForms is only used for the tray icon; keep its names out of the global scope. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Pinned: 6.2.4 is the last MIT release. 6.5+ is AGPL/commercial and refuses to run without a license. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

  <!-- Kestrel web server for phone sharing over Wi-Fi (part of .NET, nothing extra to install). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
