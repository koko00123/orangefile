<Window x:Class="Orange.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orange Settings" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F7F7F8" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FF8A1F" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#E4E4E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18">
        <!-- Title -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
            <Ellipse Width="26" Height="26" Margin="0,0,10,0">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFB040" Offset="0" />
                        <GradientStop Color="#F06E0A" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock x:Name="TitleText" Text="Orange Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- General -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="GeneralHeader" Style="{StaticResource Header}" Text="General" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" DisplayMemberPath="Value" SelectedValuePath="Key" />
                </Grid>
                <CheckBox x:Name="AutostartBox" Content="Start with Windows" />
                <CheckBox x:Name="NotifyBox" Content="Show notifications when a job finishes" />
            </StackPanel>
        </Border>

        <!-- Wheel -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="WheelHeader" Style="{StaticResource Header}" Text="Wheel" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SizeLabel" Text="Size" VerticalAlignment="Center" />
                    <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="60" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock x:Name="SizeValue" Grid.Column="2" Text="80 %" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConvertKeyLabel" Text="Key for Convert" VerticalAlignment="Center" />
                    <ComboBox x:Name="ConvertKeyBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ToolsKeyLabel" Text="Key for Tools" VerticalAlignment="Center" />
                    <ComboBox x:Name="ToolsKeyBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ActionsKeyLabel" Text="Key for Actions" VerticalAlignment="Center" />
                    <ComboBox x:Name="ActionsKeyBox" Grid.Column="1" />
                </Grid>
                <TextBlock x:Name="KeyWarning" Text="Each mode needs a different key." Foreground="#C62828"
                           Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Output -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="OutputHeader" Style="{StaticResource Header}" Text="Output" />
                <RadioButton x:Name="NextToOriginal" GroupName="Out" Content="Save next to the original file" />
                <RadioButton x:Name="ToFolder" GroupName="Out" Content="Save everything in this folder:" />
                <Grid Margin="20,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Padding="5,3" IsReadOnly="True" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="12,3" />
                </Grid>
                <Grid Style="{StaticResource Row}" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="QualityLabel" Text="Image quality (JPG, WebP, AVIF)" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock x:Name="QualityValue" Grid.Column="2" Text="90" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Phone -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="PhoneHeader" Style="{StaticResource Header}" Text="Phone (Wi-Fi sharing)" />
                <CheckBox x:Name="PhoneBox" Content="Share files with my phone over Wi-Fi" />
                <TextBlock x:Name="InboxLabel" Text="Files from the phone go to:" Margin="0,8,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InboxBox" Padding="5,3" IsReadOnly="True" />
                    <Button x:Name="InboxBrowse" Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="12,3" />
                </Grid>
                <Button x:Name="PairButton" Content="Connect phone…" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4" />
            </StackPanel>
        </Border>

        <!-- Desktop module (icon boxes) -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="DesktopHeader" Style="{StaticResource Header}" Text="Desktop (icon boxes)" />
                <CheckBox x:Name="DesktopBox" Content="Organize desktop icons into boxes" />
                <TextBlock x:Name="DesktopNote" Text="Only moves icons. Files are never moved, renamed or deleted."
                           Foreground="#6B6B73" TextWrapping="Wrap" Margin="20,0,0,4" />
                <StackPanel x:Name="DesktopOptions">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RenderModeLabel" Text="Draw boxes" VerticalAlignment="Center" />
                        <ComboBox x:Name="RenderModeBox" Grid.Column="1" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OrphanLabel" Text="Boxes of a disconnected monitor" VerticalAlignment="Center" />
                        <ComboBox x:Name="OrphanBox" Grid.Column="1" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EditHotkeyLabel" Text="Shortcut to edit the desktop" VerticalAlignment="Center" />
                        <TextBox x:Name="EditHotkeyBox" Grid.Column="1" Padding="5,3" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HideHotkeyLabel" Text="Shortcut to hide icons (optional)" VerticalAlignment="Center" />
                        <TextBox x:Name="HideHotkeyBox" Grid.Column="1" Padding="5,3" />
                    </Grid>
                    <TextBlock x:Name="HotkeyWarning" Text="Use a shortcut like Ctrl+Alt+D." Foreground="#C62828"
                               Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Updates -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="UpdatesHeader" Style="{StaticResource Header}" Text="Updates" />
                <TextBlock x:Name="VersionText" Text="Orange 1.0.0" Margin="0,0,0,4" />
                <CheckBox x:Name="AutoUpdateBox" Content="Check for new versions automatically" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="CheckNowButton" Content="Check now" Padding="12,4" />
                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#6B6B73" TextWrapping="Wrap" MaxWidth="330" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Engines -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="EnginesHeader" Style="{StaticResource Header}" Text="Engines" />
                <ItemsControl x:Name="EngineList" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="ToolsButton" Content="Check for tool updates" Padding="12,4" />
                    <TextBlock x:Name="ToolsStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#6B6B73" TextWrapping="Wrap" MaxWidth="300" />
                </StackPanel>
                <ProgressBar x:Name="ToolsProgress" Height="4" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" Foreground="{StaticResource Accent}" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" MinWidth="100" Padding="12,6" Margin="0,0,8,0"
                    Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="100" Padding="12,6" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
